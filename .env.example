# LeaveManager ortam değişkenleri — örnek dosya (docs/security.md). Gerçek değer yazmayın.
# Uygulama bu dosyayı okumaz; değişkenleri süreç ortamında tanımlayın.

# Oturum ve CSRF token'larını imzalayan gizli anahtar (spec 0011).
# Üretmek için:  python -c "import secrets; print(secrets.token_hex(32))"
# Tanımlı değilse uygulama süreç başına rastgele bir anahtar kullanır ve bir WARNING yazar;
# yeniden başlatmada açık formlar geçersizleşir. Üretimde ve birden çok süreçte mutlaka tanımlayın.
SECRET_KEY=

# Log seviyesi: DEBUG, INFO, WARNING, ERROR, CRITICAL (varsayılan INFO; spec 0009).
LOG_LEVEL=INFO
