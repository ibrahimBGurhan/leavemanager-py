# Normalize line endings; POSIX scripts must stay LF even on Windows checkouts (autocrlf=true),
# otherwise `sh` fails on the carriage return.
* text=auto
scripts/* text eol=lf
*.sh text eol=lf
*.md text
*.yml text
*.json text
# Third-party files are served byte for byte: no line-ending conversion (spec 0034, plan Risk 9).
web/static/vendor/** -text
